{
  "name": "tholenkrant",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:blog && astro dev",
    "build": "npm run prepare:blog && astro build",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "prepare": "node .githooks/install.mjs",
    "prepare:blog": "node scripts/sanitize-blog.mjs && node scripts/normalize-synced-blog.mjs && node scripts/validate-blog.mjs && node scripts/verify-blog-pipeline.mjs && node scripts/assert-blog-files.mjs",
    "prebuild": "node scripts/prebuild-sync.mjs",
    "build:ci": "NODE_OPTIONS=--max-old-space-size=8192 npm run build",
    "sync:content": "node scripts/sync-content.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^5.18.1",
    "astro-compress": "^2.4.1",
    "astro-seo": "^1.1.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.84.0",
    "jszip": "^3.10.1"
  }
}
