# Copy to .env.astropayload for local Payload sync:
#   cp .env.example .env.astropayload
#
# Required for: npm run sync:content
# Optional for: npm run build (prebuild sync runs only when credentials are present)

TENANT=tholenkrant
PAYLOAD_URL=https://your-payload-host.example
PAYLOAD_API_KEY=

# Absolute path to the astropayload monorepo (contains packages/tenant-cli)
ASTROPAYLOAD_PLATFORM_ROOT=

# Public media base for Payload / R2 images.
# Required in CI: without it /media/... cannot be rewritten to the CDN and
# featured images fall back to the built-in default base below.
R2_PUBLIC_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev
PUBLIC_R2_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev

# Must equal tenantSlug in astropayload.config.json — media lives at
# {R2_PUBLIC_URL}/tenants/{PUBLIC_TENANT_SLUG}/{filename}
PUBLIC_TENANT_SLUG=tholenkrant
