---
import Card from "./Card.astro";
import { resolveFeaturedImage } from "@lib/blogImages";

interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date: Date | string;
  /** Raw Payload value (path, absolute URL or media object) or an already-resolved URL. */
  image?: string | unknown;
  imageAlt?: string;
  category?: string;
  priority?: boolean;
}
const { href, title, excerpt, date, image, imageAlt, category, priority = false } = Astro.props;
const dateStr =
  typeof date === "string"
    ? new Date(date).toLocaleDateString("nl-NL", { year: "numeric", month: "long", day: "numeric" })
    : date.toLocaleDateString("nl-NL", { year: "numeric", month: "long", day: "numeric" });

// Resolve defensively: callers may still pass a raw /media/... path or media object.
// `fallback: false` means "no picture" stays no picture — we show the category bar.
const cover = resolveFeaturedImage({ featuredImage: image }, undefined, { fallback: false });
const coverAlt = (typeof imageAlt === "string" && imageAlt.trim()) || title || "Artikelafbeelding";

const categoryBars: Record<string, string> = {
  "lokaal":           "#1d4ed8",
  "sport":            "#16a34a",
  "politiek":         "#7c3aed",
  "politiek-bestuur": "#7c3aed",
  "evenementen":      "#ea580c",
  "buurt-wijk":       "#0891b2",
  "overige":          "#64748b",
};
const cat = (category ?? "overige").toLowerCase();
const bar = categoryBars[cat] ?? categoryBars["overige"];
---

<Card href={href} class="flex flex-col h-full">
  {cover ? (
    <div class="blog-card-media relative overflow-hidden bg-ink-100 dark:bg-ink-800 flex-shrink-0">
      <div class="absolute top-0 left-0 right-0 h-1 z-10" style={`background: ${bar};`}></div>
      <img
        src={cover}
        alt={coverAlt}
        width="640"
        height="360"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding={priority ? "sync" : "async"}
        class="blog-card-media__img absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        data-bar={bar}
        onerror="this.onerror=null;const m=this.closest('.blog-card-media');if(m){const b=document.createElement('div');b.className='h-1 w-full flex-shrink-0';b.style.background=this.dataset.bar;m.replaceWith(b);}else{this.remove();}"
      />
    </div>
  ) : (
    <div class="h-1 w-full flex-shrink-0" style={`background: ${bar};`}></div>
  )}

  <div class="flex-1 flex flex-col p-5 gap-2">
    {category && (
      <span class="text-[11px] font-bold uppercase tracking-widest text-ink-400 dark:text-ink-500">
        {category}
      </span>
    )}
    <h2 class="text-base font-display font-bold leading-snug text-[color:var(--text)] group-hover:text-accent-600 transition-colors line-clamp-3">
      {title}
    </h2>
    {excerpt && (
      <p class="text-sm text-[color:var(--text-muted)] line-clamp-2 flex-1 leading-relaxed">
        {excerpt}
      </p>
    )}
    <time datetime={typeof date === "string" ? date : date.toISOString()} class="text-xs text-[color:var(--text-muted)] mt-auto pt-2 border-t border-[color:var(--border)]">
      {dateStr}
    </time>
  </div>
</Card>
