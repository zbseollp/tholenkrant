---
interface Props {
  class?: string;
  forceWhite?: boolean;
}
const { class: className = "", forceWhite = false } = Astro.props;
const textColor = forceWhite ? "text-white" : "text-ink-900";
const subColor = forceWhite ? "text-white/80" : "text-ink-900";
---

<a href="/" class:list={["inline-flex items-center gap-2 group", className]} aria-label="Tholen Krant home">
  <!-- Megaphone icon -->
  <svg class="h-9 w-9 flex-shrink-0" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="20" cy="20" r="20" fill={forceWhite ? "white" : "#fee2e2"}/>
    <!-- Megaphone body -->
    <path d="M28 11 L14 17 L14 23 L28 29 Z" fill="#dc2626"/>
    <!-- Speaker base -->
    <rect x="9" y="17" width="5" height="6" rx="1" fill="#dc2626"/>
    <!-- Sound waves -->
    <path d="M31 16 Q33.5 20 31 24" stroke="#dc2626" fill="none" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M33.5 13.5 Q37 20 33.5 26.5" stroke="#dc2626" fill="none" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
  </svg>

  <div class="leading-tight">
    <div class:list={["font-bold text-sm md:text-base leading-snug", textColor]}>
      Tholen
    </div>
    <div class:list={["font-bold text-sm md:text-base leading-snug", subColor]}>
      Krant.nl
    </div>
  </div>
</a>
