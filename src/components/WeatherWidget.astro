---
// Tholen coords: 51.9797, 4.6167
---

<div id="weather-widget" class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5 overflow-hidden">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-bold uppercase tracking-wider text-[color:var(--text)]">Weer in Tholen</h3>
    <svg class="h-4 w-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z"/>
    </svg>
  </div>

  <div id="weather-loading" class="py-4 text-center text-xs text-[color:var(--text-muted)]">Weer laden...</div>

  <div id="weather-content" class="hidden">
    <div class="flex items-end gap-3 mb-4">
      <div id="weather-icon" class="text-4xl leading-none"></div>
      <div>
        <div class="flex items-end gap-1">
          <span id="weather-temp" class="text-3xl font-display font-bold text-[color:var(--text)]"></span>
          <span class="text-sm text-[color:var(--text-muted)] mb-1">°C</span>
        </div>
        <div id="weather-desc" class="text-xs text-[color:var(--text-muted)] capitalize"></div>
      </div>
      <div class="ml-auto text-right text-xs text-[color:var(--text-muted)] space-y-0.5">
        <div>Regen: <span id="weather-rain" class="font-medium text-[color:var(--text)]"></span></div>
        <div>Wind: <span id="weather-wind" class="font-medium text-[color:var(--text)]"></span></div>
      </div>
    </div>

    <div id="weather-forecast" class="grid grid-cols-3 gap-1.5 pt-3 border-t border-[color:var(--border)]"></div>
  </div>

  <div id="weather-error" class="hidden py-2 text-xs text-[color:var(--text-muted)]">Weerdata tijdelijk niet beschikbaar.</div>
</div>

<script>
const WMO: Record<number, [string, string]> = {
  0: ["Helder", "☀️"], 1: ["Overwegend helder", "🌤️"], 2: ["Gedeeltelijk bewolkt", "⛅"],
  3: ["Bewolkt", "☁️"], 45: ["Mistig", "🌫️"], 48: ["Rijpvorst", "🌫️"],
  51: ["Lichte motregen", "🌦️"], 53: ["Matige motregen", "🌦️"], 55: ["Dichte motregen", "🌧️"],
  61: ["Lichte regen", "🌧️"], 63: ["Matige regen", "🌧️"], 65: ["Zware regen", "🌧️"],
  71: ["Lichte sneeuw", "🌨️"], 73: ["Matige sneeuw", "🌨️"], 75: ["Zware sneeuw", "❄️"],
  80: ["Lichte buien", "🌦️"], 81: ["Buien", "🌧️"], 82: ["Zware buien", "⛈️"],
  95: ["Onweer", "⛈️"], 96: ["Onweer met hagel", "⛈️"],
};
const days = ["zo", "ma", "di", "wo", "do", "vr", "za"];

async function loadWeather() {
  try {
    const url = "https://api.open-meteo.com/v1/forecast?latitude=51.9797&longitude=4.6167&current=temperature_2m,weathercode,windspeed_10m,precipitation&daily=weathercode,temperature_2m_max,temperature_2m_min&timezone=Europe%2FAmsterdam&forecast_days=4";
    const res = await fetch(url);
    if (!res.ok) throw new Error();
    const d = await res.json();
    const c = d.current;
    const wmo = WMO[c.weathercode] ?? ["Onbekend", "🌡️"];

    document.getElementById("weather-icon")!.textContent = wmo[1];
    document.getElementById("weather-temp")!.textContent = Math.round(c.temperature_2m).toString();
    document.getElementById("weather-desc")!.textContent = wmo[0];
    document.getElementById("weather-rain")!.textContent = c.precipitation + " mm";
    document.getElementById("weather-wind")!.textContent = Math.round(c.windspeed_10m) + " km/u";

    const fc = document.getElementById("weather-forecast")!;
    d.daily.time.slice(1, 4).forEach((date: string, i: number) => {
      const code = d.daily.weathercode[i + 1];
      const icon = (WMO[code] ?? ["", "🌡️"])[1];
      const dow = days[new Date(date).getDay()];
      const hi = Math.round(d.daily.temperature_2m_max[i + 1]);
      const lo = Math.round(d.daily.temperature_2m_min[i + 1]);
      fc.insertAdjacentHTML("beforeend", `
        <div class="rounded-lg bg-[color:var(--surface-raised,#f8fafc)] dark:bg-ink-800/60 p-2 text-center">
          <div class="text-xs text-[color:var(--text-muted)] font-medium">${dow}</div>
          <div class="text-xl my-0.5">${icon}</div>
          <div class="text-xs font-semibold text-[color:var(--text)]">${hi}°</div>
          <div class="text-xs text-[color:var(--text-muted)]">${lo}°</div>
        </div>
      `);
    });

    document.getElementById("weather-loading")!.classList.add("hidden");
    document.getElementById("weather-content")!.classList.remove("hidden");
  } catch {
    document.getElementById("weather-loading")!.classList.add("hidden");
    document.getElementById("weather-error")!.classList.remove("hidden");
  }
}

loadWeather();
</script>
